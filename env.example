# Salin menjadi .env lalu isi. Jangan pernah commit/upload file .env ke publik.
# Komentar harus di baris sendiri. Nilai yang mengandung tanda # dibungkus tanda kutip.

# --- Aplikasi ---------------------------------------------------------------
# URL publik tanpa "/" di akhir. Dipakai untuk isi QR, NFC, dan file export.
BASE_URL=https://domain.com
PORT=3000
# 127.0.0.1 = hanya bisa diakses lewat reverse proxy (disarankan).
# Gunakan 0.0.0.0 bila dijalankan di Docker / platform PaaS.
HOST=127.0.0.1
# 1 = aplikasi berada di belakang Caddy/Nginx/Cloudflare (IP asli dibaca dari
# X-Forwarded-For untuk rate limit). 0 = diakses langsung tanpa proxy.
TRUST_PROXY=1

# --- Admin (login lewat /login, wajib lewat HTTPS) --------------------------
ADMIN_USER=admin
# Minimal 10 karakter.
ADMIN_PASS=

# Opsional: akun kedua dengan akses terbatas — hanya menu Kelola Tag (Scan QR).
# Kosongkan STAFF_USER bila tidak perlu akun ini; ADMIN_USER/ADMIN_PASS tetap wajib di atas.
STAFF_USER=
# Wajib diisi (minimal 10 karakter) jika STAFF_USER diisi.
STAFF_PASS=

# --- Database MySQL / MariaDB -----------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qrnfc
DB_USER=qrnfc
DB_PASS=
# Isi 1 jika database di-hosting terpisah lewat internet (mis. Aiven, PlanetScale, dll).
# Biarkan 0 untuk database lokal (127.0.0.1) seperti pada instalasi VPS di atas.
DB_SSL=0
DB_SSL_STRICT=0

# --- Domain yang boleh diisi pada form (pisahkan dengan koma) ---------------
# Subdomain ikut diizinkan. Kosongkan nilainya untuk mengizinkan semua domain http(s).
ALLOWED_HOSTS=google.com,google.co.id,g.page,g.co,goo.gl,forms.gle,share.google
